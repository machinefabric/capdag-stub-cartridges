{
  "contract_version": 1,
  "placeholder": "__CARTRIDGE_NAME__",
  "languages": {
    "python": {
      "flag": "--python",
      "display": "Python",
      "entry": "cartridge.py",
      "build": [],
      "runtime": {
        "registry": "PyPI",
        "package": "capdag",
        "install": "pip install capdag"
      },
      "files": [
        { "source": "stubs/python/cartridge.py", "dest": "cartridge.py", "executable": true },
        { "source": "stubs/python/README.md", "dest": "README.md", "executable": false },
        { "source": "stubs/python/gitignore", "dest": ".gitignore", "executable": false }
      ]
    },
    "rust": {
      "flag": "--rust",
      "display": "Rust",
      "entry": "target/release/__CARTRIDGE_NAME__",
      "build": ["cargo build --release"],
      "runtime": {
        "registry": "git tag",
        "package": "capdag",
        "install": "cargo build (the dependency is declared in Cargo.toml)"
      },
      "files": [
        { "source": "stubs/rust/src/main.rs", "dest": "src/main.rs", "executable": false },
        { "source": "stubs/rust/Cargo.toml", "dest": "Cargo.toml", "executable": false },
        { "source": "stubs/rust/cargo-config.toml", "dest": ".cargo/config.toml", "executable": false },
        { "source": "stubs/rust/README.md", "dest": "README.md", "executable": false },
        { "source": "stubs/rust/gitignore", "dest": ".gitignore", "executable": false }
      ]
    },
    "go": {
      "$comment": [
        "-buildvcs=false because a scaffold is not a git repository. Go stamps",
        "VCS metadata into a binary by default, and go1.26 with git2.53 fails",
        "the build outright when the probe returns exit 128 rather than",
        "recording no VCS — so the command this file documents did not build",
        "the project this file creates. Nothing here wants the stamp: a",
        "cartridge binary is identified by its content hash and its signature."
      ],
      "flag": "--go",
      "display": "Go",
      "entry": "__CARTRIDGE_NAME__",
      "build": ["go mod tidy", "go build -buildvcs=false -o __CARTRIDGE_NAME__ ."],
      "runtime": {
        "registry": "git tag",
        "package": "github.com/machinefabric/capdag-go",
        "install": "go mod tidy"
      },
      "files": [
        { "source": "stubs/go/cartridge.go", "dest": "cartridge.go", "executable": false },
        { "source": "stubs/go/go.mod", "dest": "go.mod", "executable": false },
        { "source": "stubs/go/README.md", "dest": "README.md", "executable": false },
        { "source": "stubs/go/gitignore", "dest": ".gitignore", "executable": false }
      ]
    },
    "swift": {
      "flag": "--swift",
      "display": "Swift",
      "entry": ".build/release/__CARTRIDGE_NAME__",
      "build": ["swift build -c release"],
      "runtime": {
        "registry": "git tag",
        "package": "capdag-objc",
        "install": "swift build (the dependency is declared in Package.swift)"
      },
      "files": [
        { "source": "stubs/swift/Sources/main.swift", "dest": "Sources/main.swift", "executable": false },
        { "source": "stubs/swift/Package.swift", "dest": "Package.swift", "executable": false },
        { "source": "stubs/swift/README.md", "dest": "README.md", "executable": false },
        { "source": "stubs/swift/gitignore", "dest": ".gitignore", "executable": false }
      ]
    }
  }
}
